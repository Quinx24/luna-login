# Public Firebase web configuration (existing project, not Admin credentials)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Server only. NEVER prefix secrets with VITE_.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
FIREBASE_PROJECT_ID=
# Set to the absolute path of your Admin service account JSON, outside this repository.
GOOGLE_APPLICATION_CREDENTIALS=
# For hosting without a credential file, set this server-only JSON secret instead.
FIREBASE_SERVICE_ACCOUNT_JSON=
PORT=3001
